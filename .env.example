# ==============================================================================
# API Atlas Environment Configuration
# Safe example template containing placeholders only. Never commit real secrets.
# ==============================================================================

PORT=4321
HOST=localhost
NODE_ENV=development

# Application branding & public metadata
PUBLIC_APP_NAME="API Atlas"
PUBLIC_APP_DESCRIPTION="Production Visual API Explorer"

# Spec storage & upload configuration
API_ATLAS_DATA_DIR="./.api-atlas"
MAX_SPEC_SIZE_MB=10
ENABLE_MOCK_SERVER=true

# ==============================================================================
# Better Auth & Core Authentication Configuration
# ==============================================================================
# Base URL where API Atlas is hosted (used for OAuth redirects and cookies)
# In development: http://localhost:4321
# In production: https://your-domain.com
BETTER_AUTH_URL="http://localhost:4321"

# Cryptographic secret for signing sessions, tokens, and OAuth state
# Generate a strong 32-byte secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="your_better_auth_secret_minimum_32_characters_placeholder"

# Persistent PostgreSQL database URL for Drizzle ORM
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# When unset or unreachable, API Atlas falls back to safe local store (.api-atlas/auth-store.json)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/api_atlas"

# Session Duration
SESSION_COOKIE_NAME="atlas_session"
SESSION_EXPIRATION_DAYS=7

# Rate Limiter Thresholds
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# ==============================================================================
# GitHub OAuth Provider Configuration
# Generated in: GitHub -> Settings -> Developer Settings -> OAuth Apps
# Authorized Callback URL: http://localhost:4321/api/auth/callback/github
# ==============================================================================
GITHUB_CLIENT_ID="your_github_client_id_placeholder"
GITHUB_CLIENT_SECRET="your_github_client_secret_placeholder"

# ==============================================================================
# Google OAuth Provider Configuration
# Generated in: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized JavaScript Origin: http://localhost:4321
# Authorized Redirect URI: http://localhost:4321/api/auth/callback/google
# ==============================================================================
GOOGLE_CLIENT_ID="your_google_client_id_placeholder"
GOOGLE_CLIENT_SECRET="your_google_client_secret_placeholder"
