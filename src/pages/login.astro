---
import Layout from '@/layouts/Layout.astro';
import { Logo } from '@/components/ui/Logo';
import { Button } from '@/components/ui/Button';
import { ArrowLeft, ShieldCheck, KeyRound } from 'lucide-react';
---

<Layout
  title="Sign In — API Atlas"
  description="Sign in to your API Atlas workspace or continue using the local sandbox."
>
  <div class="min-h-screen flex flex-col items-center justify-center bg-[#0A101D] text-[#F4F7FB] px-4 py-12 relative">
    <!-- Ambient glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[300px] bg-gradient-to-r from-[#2A4494]/20 via-[#4EA5D9]/15 to-transparent blur-3xl pointer-events-none -z-10"></div>

    <div class="w-full max-w-md space-y-8">
      {/* Back to Home Link */}
      <div>
        <a
          href="/"
          class="inline-flex items-center gap-1.5 text-xs text-[#9BB0CC] hover:text-[#44CFCB] transition-colors"
        >
          <ArrowLeft className="w-4 h-4" />
          <span>Back to Landing Page</span>
        </a>
      </div>

      {/* Main Card */}
      <div class="p-8 rounded-2xl bg-[#0E1726] border border-[#224870] shadow-2xl space-y-6">
        <div class="text-center space-y-2">
          <div class="flex justify-center pb-2">
            <Logo size="lg" />
          </div>
          <h1 class="text-2xl font-bold tracking-tight text-[#F4F7FB]">
            Sign in to API Atlas
          </h1>
          <p class="text-xs text-[#9BB0CC]">
            Access saved contract workspaces, team mocks, and synchronized endpoints.
          </p>
        </div>

        {/* OAuth Button */}
        <div class="space-y-3 pt-2">
          <a href="/workspace" class="block w-full">
            <Button variant="secondary" size="lg" className="w-full justify-center">
              <svg class="w-4 h-4 mr-2 fill-current" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
              <span>Continue with GitHub</span>
            </Button>
          </a>

          <div class="relative py-2">
            <div class="absolute inset-0 flex items-center">
              <div class="w-full border-t border-[#224870]"></div>
            </div>
            <div class="relative flex justify-center text-xs">
              <span class="px-2 bg-[#0E1726] text-[#627898] font-mono">OR EMAIL</span>
            </div>
          </div>

          <form action="/workspace" method="GET" class="space-y-4">
            <div class="space-y-1.5 text-left">
              <label for="email" class="block text-xs font-medium text-[#E2EAF4]">
                Work Email
              </label>
              <input
                id="email"
                type="email"
                placeholder="developer@company.com"
                required
                class="w-full px-3 py-2 rounded-lg bg-[#080D18] border border-[#224870] text-[#F4F7FB] text-xs font-mono placeholder-[#627898] focus:outline-none focus:border-[#4EA5D9]"
              />
            </div>

            <Button type="submit" variant="primary" size="lg" className="w-full justify-center shadow-md shadow-[#2A4494]/30">
              <KeyRound className="w-4 h-4 mr-2 text-[#44CFCB]" />
              <span>Sign In with Magic Link</span>
            </Button>
          </form>
        </div>

        {/* Local Sandbox Option */}
        <div class="pt-4 border-t border-[#224870]/60 text-center">
          <p class="text-xs text-[#9BB0CC]">
            Prefer not to sign in?{' '}
            <a href="/workspace" class="text-[#4EA5D9] hover:text-[#44CFCB] font-semibold underline underline-offset-2">
              Launch Local Sandbox
            </a>
          </p>
        </div>
      </div>

      {/* Security badge */}
      <div class="flex items-center justify-center gap-2 text-xs text-[#627898]">
        <ShieldCheck className="w-4 h-4 text-[#44CFCB]" />
        <span>End-to-end local privacy • Zero cloud telemetry</span>
      </div>
    </div>
  </div>
</Layout>
