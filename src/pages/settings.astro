---
import AppShell from '@/layouts/AppShell.astro';
import { SettingsForm } from '@/components/settings/SettingsForm';
---

<AppShell title="Settings - API Atlas">
  <div class="p-6 sm:p-8 lg:p-10 max-w-7xl mx-auto w-full space-y-8 font-sans">
    <!-- Page Header with Context Badge -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-6 border-b border-[#224870]/60">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#142034] border border-[#224870]/80 text-[11px] font-semibold text-[#4EA5D9] tracking-wide uppercase mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-[#44CFCB] animate-pulse"></span>
          Workspace Configuration • Engine Core v0.1.0-alpha
        </div>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#F4F7FB]">
          Settings & Preferences
        </h1>
        <p class="mt-1.5 text-sm text-[#9BB0CC] max-w-2xl leading-relaxed">
          Manage workspace behaviors, OpenAPI parser validation rules, mock sandbox network latency, and monitor live runtime engine telemetry.
        </p>
      </div>

      <div class="flex items-center gap-3 shrink-0">
        <div class="px-3.5 py-2 rounded-xl bg-[#0E1726]/80 border border-[#224870]/80 flex items-center gap-2.5 shadow-xs">
          <div class="w-2 h-2 rounded-full bg-[#44CFCB] ring-4 ring-[#44CFCB]/20"></div>
          <span class="text-xs font-semibold text-[#E2EAF4]">Local Engine Active</span>
        </div>
      </div>
    </div>

    <!-- Modernized Settings View -->
    <section>
      <SettingsForm client:load />
    </section>
  </div>
</AppShell>
